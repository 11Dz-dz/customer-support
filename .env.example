# 实际密钥和连接口令只写入 .env，不提交到代码或文档。
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_MODEL=deepseek-flash
DATABASE_URL=postgresql://agent_customer:CHANGE_ME@127.0.0.1:5432/agent_customer
# 会话检查点默认复用 DATABASE_URL，可选配置独立 PostgreSQL 数据库：
# CHECKPOINT_DATABASE_URL=postgresql://user:password@127.0.0.1:5432/chat_sessions
TEST_ORDER_ID=43659
EMBEDDING_MODEL_PATH=./models/multilingual-e5-small
EMBEDDING_MODEL_REVISION=761b726dd34fb83930e26aab4e9ac3899aa1fa78
EMBEDDING_CPU_THREADS=1
EMBEDDING_BATCH_SIZE=10
EMBEDDING_MAX_LENGTH=512
