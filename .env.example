# 实际密钥和连接口令只写入 .env，不提交到代码或文档。
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_MODEL=deepseek-flash
DATABASE_URL=postgresql://agent_customer:CHANGE_ME@127.0.0.1:5432/agent_customer
# 会话检查点默认复用 DATABASE_URL，可选配置独立 PostgreSQL 数据库：
# CHECKPOINT_DATABASE_URL=postgresql://user:password@127.0.0.1:5432/chat_sessions
TEST_ORDER_ID=43659
EMBEDDING_MODEL_PATH=./models/multilingual-e5-small
EMBEDDING_MODEL_REVISION=761b726dd34fb83930e26aab4e9ac3899aa1fa78
EMBEDDING_CPU_THREADS=1
EMBEDDING_BATCH_SIZE=10
EMBEDDING_MAX_LENGTH=512

# Web service: browser origin must match exactly. Local SSH tunnel default:
WEB_BASE_URL=http://127.0.0.1:8000
# Set to 0.0.0.0 for a platform public port, then set WEB_BASE_URL to its HTTPS URL.
WEB_BIND_HOST=127.0.0.1
WEB_MAX_CONCURRENT_RUNS=2

# Optional execution tracing. Create a LangSmith key, never commit a real value.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=customer-support
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# Use your console's regional endpoint/workspace when applicable.
# LANGSMITH_WORKSPACE_ID=
# If your LangSmith workspace uses registered agents, copy the ID from its console:
# LANGSMITH_AGENT_ID=
# LANGSMITH_AGENT_ENVIRONMENT=development
# Optional metadata-only tracing:
# LANGSMITH_HIDE_INPUTS=true
# LANGSMITH_HIDE_OUTPUTS=true

# Official: deepseek; Alibaba Model Studio: bailian (keys are not interchangeable)
DEEPSEEK_PROVIDER=deepseek
DEEPSEEK_BASE_URL=https://api.deepseek.com
# For Bailian Beijing use provider=bailian, base=https://dashscope.aliyuncs.com/compatible-mode/v1
# and model=deepseek-v4.1-flash-1017. Keep the key in DEEPSEEK_API_KEY.
