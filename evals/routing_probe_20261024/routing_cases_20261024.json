[
  {
    "id": "N01",
    "category": "continuation",
    "title": "复合目标后只补订单号",
    "actor": "owner",
    "turns": [
      {
        "input": "帮我挑一款自行车整车，顺便看看我的订单；单号等下发。",
        "expect": {
          "no_write": true,
          "at_least_tools": [
            "search_products"
          ],
          "displayed_products": 1,
          "product_kind": "bicycle",
          "all_statuses": {
            "awaiting_input": 1
          }
        }
      },
      {
        "input": "{own_order}",
        "expect": {
          "no_write": true,
          "tools": [
            "query_order"
          ],
          "contains": [
            "{own_order}"
          ],
          "tool_arguments": {
            "query_order": {
              "order_id": "{own_order}"
            }
          }
        }
      }
    ]
  },
  {
